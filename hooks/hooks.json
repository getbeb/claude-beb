{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/beb-identity.sh",
            "timeout": 5,
            "statusMessage": "beb: pinning identity"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/beb-drain.sh",
            "timeout": 15,
            "statusMessage": "beb: checking mail"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/beb-doorbell.sh",
            "async": true,
            "asyncRewake": true,
            "timeout": 90000,
            "statusMessage": "beb: listening for mail"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/beb-drain.sh",
            "timeout": 15,
            "statusMessage": "beb: checking mail"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/beb-doorbell.sh",
            "async": true,
            "asyncRewake": true,
            "timeout": 90000,
            "statusMessage": "beb: listening for mail"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/beb-hush.sh",
            "timeout": 5,
            "statusMessage": "beb: standing the doorbell down"
          }
        ]
      }
    ]
  }
}
